# Vor dem Start nach .env kopieren; .env NICHT ins oeffentliche Git-Repository laden.
# Feste LAN-IP deiner Synology, keine Portnummer und kein https:// davor:
LAN_HOST=192.168.178.20
# DSM nutzt standardmaessig 5000/5001; 8443 ist ein eigenstaendiger App-Port.
HTTPS_PORT=8443
# Mindestens 24 zufaellige Zeichen; fuer PostgreSQL einfaches URL-taugliches Passwort verwenden.
POSTGRES_PASSWORD=BITTE_EIN_LANGES_ZUFAELLIGES_PASSWORT_SETZEN
APP_PASSWORD=BITTE_EIN_ANDERES_LANGES_ZUFAELLIGES_PASSWORT_SETZEN
# Mindestens 32 zufaellige Bytes; Beispiel: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
APP_SECRET_KEY=BITTE_EIN_ZUFAELLIGES_SECRET_SETZEN
